{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hiload Plant Maintenance",
  "version": "0.1.0",
  "identifier": "com.hiload.plantmaintenance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hiload Plant Maintenance",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "url": "Hiload Plant Latest.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
